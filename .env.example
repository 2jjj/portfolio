# Banco de Dados (Supabase)
DATABASE_URL=postgresql://postgres:suasenha@db.seuprojeto.supabase.co:6543/postgres

# Banco dedicado para testes de integracao (nunca use producao)
TEST_DATABASE_URL=postgresql://postgres:suasenha@localhost:5432/portfolio_test

# Admin
ADMIN_PASSWORD=coloque-uma-senha-forte-aqui
JWT_SECRET=coloque-um-secreto-aleatorio-longo-aqui
JWT_REFRESH_SECRET=outro-secreto-para-refresh-tokens

# GitHub
GITHUB_USERNAME=seu-usuario-github
GITHUB_TOKEN=seu-token-de-acesso-github

# Migrations em producao (opcional)
# No Vercel as migrations ficam desligadas no cold start.
# Defina um token forte e chame POST /api/maintenance/migrate quando precisar.
MAINTENANCE_TOKEN=um-token-forte-e-aleatorio
# RUN_MIGRATIONS=1

# Frontend
PORT=3001
VITE_API_URL=http://localhost:3001

# Logs
LOG_LEVEL=info

# CORS (opcional - dominios permitidos separados por virgula)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3001
